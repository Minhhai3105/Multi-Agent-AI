# Copy to .env and edit. Never commit .env (it is in .gitignore).

# --- LLM provider: auto | gemini | openai_compatible | mock
#   auto              = Gemini if GEMINI_API_KEY is set, otherwise the offline mock
#   openai_compatible = any OpenAI-compatible gateway, e.g. CLIProxyAPI on your machine
#   mock              = offline simulated answers (no key, no quota)
LLM_PROVIDER=auto

# Option A - Google AI Studio key (direct Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option B - OpenAI-compatible gateway (set LLM_PROVIDER=openai_compatible)
#   CLIProxyAPI: the key is its *client access key*, not a Google key.
#   Inside Docker use host.docker.internal; 127.0.0.1 would be the container itself.
#   Pick LLM_MODEL from: python scripts/check_llm_connection.py (lists GET /v1/models)
LLM_BASE_URL=http://host.docker.internal:8317/v1
LLM_API_KEY=
LLM_MODEL=

# Shared limits. Thinking models behind a proxy are slow: 120 s is a safe timeout,
# and LLM_MAX_OUTPUT_TOKENS=0 lets the gateway decide the output length.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048

# --- Security: use a long random string in any shared deployment
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=480

# --- Demo controls (fault injection panel for QA scenarios). Set false in production.
DEMO_MODE=true
MOCK_LLM_LATENCY_MS=800
SEED_ON_STARTUP=true

# --- Database (used by docker compose)
POSTGRES_DB=maap
POSTGRES_USER=maap
POSTGRES_PASSWORD=maap_dev_password
DB_PORT=5432
APP_PORT=8000

# --- Optional e-mail notifications (FR6.3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
