# Copy to .env and edit. Never commit .env (it is in .gitignore).

# --- LLM (Gemini). Leave GEMINI_API_KEY empty to use the offline mock provider.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048

# --- Security: use a long random string in any shared deployment
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=480

# --- Demo controls (fault injection panel for QA scenarios). Set false in production.
DEMO_MODE=true
MOCK_LLM_LATENCY_MS=800
SEED_ON_STARTUP=true

# --- Database (used by docker compose)
POSTGRES_DB=maap
POSTGRES_USER=maap
POSTGRES_PASSWORD=maap_dev_password
DB_PORT=5432
APP_PORT=8000

# --- Optional e-mail notifications (FR6.3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
